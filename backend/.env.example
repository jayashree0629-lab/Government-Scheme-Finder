# Copy this file to .env and fill in real values. Never commit .env.

# Required: get a key at https://serpapi.com/manage-api-key
SERPAPI_API_KEY=

# Required: get a key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Optional: overrides the default Gemini model
GEMINI_MODEL=gemini-3.5-flash-lite

PORT=3001
NODE_ENV=development

# Must match the URL the frontend runs on (Vite default shown)
FRONTEND_ORIGIN=http://localhost:5173

# DEPRECATED (no longer used) — superseded by MAX_TOTAL_SEARCH_QUERIES below
MAX_SEARCH_QUERIES_PER_REQUEST=6

# Max organic results kept per individual SerpApi query
MAX_RESULTS_PER_QUERY=6

# Bounded retrieval budget (all optional; defaults shown)
# Queries per government level (Central / state) in the first search round
MAX_QUERIES_PER_LEVEL=4
# Extra alternative queries per level if that level returned too few useful official results
MAX_RETRY_QUERIES_PER_LEVEL=2
# Absolute cap on SerpApi searches for one request (both rounds, both levels)
MAX_TOTAL_SEARCH_QUERIES=12
# Official, relevant results a level needs before we stop retrying it
MIN_USEFUL_RESULTS_PER_LEVEL=3

# Abuse / cost protection for POST /api/search (optional; defaults shown)
# Total searches allowed per hour across ALL clients (each search costs several SerpApi + Gemini calls)
MAX_SEARCHES_PER_HOUR=150
# Searches allowed to run at the same time
MAX_CONCURRENT_SEARCHES=4
