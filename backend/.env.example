# Copy this file to .env and fill in real values. Never commit .env.

# Required: get a key at https://serpapi.com/manage-api-key
SERPAPI_API_KEY=

# Required: get a key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Optional: overrides the default Gemini model
GEMINI_MODEL=gemini-3.5-flash-lite

PORT=3001
NODE_ENV=development

# Must match the URL the frontend runs on (Vite default shown)
FRONTEND_ORIGIN=http://localhost:5173

# Safety cap on how many SerpApi queries the agent may run per request
MAX_SEARCH_QUERIES_PER_REQUEST=6

# Max organic results kept per individual SerpApi query
MAX_RESULTS_PER_QUERY=6
